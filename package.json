{
  "name": "@bloomengine/web",
  "version": "0.1.0",
  "description": "A browser for web games on Bloom: DOM, events, fetch, localStorage, canvas, Web Audio and <audio>, natively, compiled by Perry",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Bloom-Engine/web.git" },
  "homepage": "https://github.com/Bloom-Engine/web#readme",
  "keywords": ["bloom", "perry", "dom", "web-audio", "native", "game"],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./dom": "./src/dom/index.ts",
    "./frame": "./src/frame.ts",
    "./canvas2d": "./src/canvas2d.ts",
    "./audio": "./src/audio/index.ts",
    "./fetch": "./src/fetch.ts"
  },
  "files": ["src/", "README.md", "LICENSE"],
  "scripts": {
    "test": "node --no-warnings tests/dom.test.ts",
    "test:perry": "mkdir -p .build && perry compile tests/dom.test.ts -o .build/dom-test && .build/dom-test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@bloomengine/engine": ">=0.4.17"
  },
  "perry": {
    "allow": { "nativeLibrary": ["@bloomengine/*"] }
  }
}
